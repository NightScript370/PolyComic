server {
    listen 80;
    server_name polycomic.example.com;   # placeholder; add TLS (certbot) for real use

    client_max_body_size 15m;

    location / {
        proxy_pass http://127.0.0.1:7659;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Server-Sent Events (progress streams)
    # No trailing slash: otherwise nginx 301-redirects /api/books to /api/books/ and loops with the app's redirect.
    location /api/books {
        proxy_pass http://127.0.0.1:7659;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
