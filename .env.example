# Copy to .env and fill in. Never commit .env.
# postgres:// and postgresql:// URLs (e.g. from Render) are rewritten to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://polycomic:change-me@localhost:5432/polycomic
# Required unless IMAGE_PROVIDER=fake or DEV_LOGIN=1. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
# gemini | openai | fake (fake = offline placeholder images, no key needed)
IMAGE_PROVIDER=gemini
# Empty = default from app/config.py (gemini-3-pro-image / gemini-3.8-flash)
# Cheaper image alternative: gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL=
GEMINI_VISION_MODEL=
GEMINI_IMAGE_SIZE=
OPENAI_IMAGE_MODEL=
# Google OAuth "Web application" client; authorized redirect URI: <PUBLIC_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Port the app listens on (scripts/run_local.*, Docker). Default 7659.
PORT=7659
# Exactly the URL users open (scheme + host, no trailing slash). https => Secure cookie.
# Locally it must match PORT; the Google OAuth redirect URI in Google Cloud Console
# must then be http://localhost:7659/auth/callback.
PUBLIC_BASE_URL=http://localhost:7659
# Local testing only: 1 enables POST /auth/dev-login (sign in without Google).
# Ignored when PUBLIC_BASE_URL is https. Never set on a public server.
DEV_LOGIN=0
# Story pages per book: all (default) or e.g. 1,2,3 / 1-3,20 for cheap test runs.
BOOK_PAGES=all
# Generation pipeline (empty = default). Page model of the Professional tier (when
# PROFESSIONAL_IMAGE_MODEL is empty); defaults to GEMINI_IMAGE_MODEL.
PAGE_IMAGE_MODEL=
# scripts/pregenerate_assets.py model and concurrency
PREGEN_IMAGE_MODEL=
PREGEN_CONCURRENCY=4
# Image calls in flight per process (all books together)
IMAGE_CONCURRENCY=20
# Optional cap on image calls started per minute (per process) for a provider per-minute
# quota; 0 = off. A 429 rate limit is retried after the server's retry delay / backoff,
# up to IMAGE_RATE_LIMIT_RETRIES times per call, never past QUALITY_HARD_CAP_S.
IMAGE_MAX_PER_MINUTE=0
IMAGE_RATE_LIMIT_RETRIES=3
# Max reference images per call (0 = provider default: 14 for Gemini 3 image models)
IMAGE_MAX_REFS=0
# Token-aware per-minute limiter for image calls (estimated input tokens of prompt + refs,
# corrected by the API's usage); stays under Google's 100k input-tokens/min quota. 0 = off.
IMAGE_INPUT_TOKENS_PER_MINUTE=90000
# References are downscaled to this longest side (JPEG) before an image call; 0 = unchanged
IMAGE_REF_MAX_SIDE=768
# Gemini per-reference media_resolution: low | medium | high | ultra_high (empty = API
# default). FIRST = the identity anchor (hero reference on pages, photo on the hero call)
IMAGE_REF_MEDIA_RESOLUTION=medium
IMAGE_REF_MEDIA_RESOLUTION_FIRST=high
# Quality loop: generations per picture and pass thresholds (0..1)
QUALITY_MAX_ATTEMPTS=3
QUALITY_MIN_LIKENESS=0.6
QUALITY_MIN_LIKENESS_HERO=0.6
QUALITY_MIN_FIDELITY=0.6
# Quality-loop time budget from the start of the book job (s): after it, a failing picture
# keeps its best attempt instead of regenerating (hero: at least 2). 0 = no budget.
QUALITY_TIME_BUDGET_S=45
# Hard cap (s from the job start): no retry generation, rate-limit wait or token queue
# that would END past it (image + grade, learned per book); only a picture without any
# image may pass it. Also allows ONE extra generation after the budget for a definite
# error (duplicate / contradiction, blank or blurred band, identity mismatch) if it fits.
# 0 = no cap.
QUALITY_HARD_CAP_S=70
# Book wall-clock target (s); slower books log a warning
BOOK_TIME_TARGET_S=60
# Vision grader thinking level: minimal | low | medium | high
GRADER_THINKING_LEVEL=low
# Grader input images are downscaled to this longest side (px, JPEG); 0 = unchanged
GRADER_IMAGE_MAX_SIDE=768
# Grader per-image media_resolution: low | medium | high | ultra_high (empty = API default,
# high). FIRST = the picture under check, the other = every reference image
GRADER_MEDIA_RESOLUTION=low
GRADER_MEDIA_RESOLUTION_FIRST=medium
# Per-book cost cap per tier (estimated USD). Optional calls (retries, the definite-error
# extra, family sheet regeneration, speaker portraits) are skipped when they would pass it;
# hero, first pictures and first grades always run. Shared first-time cast sheets are not
# counted. 0 = no cap.
COST_CAP_COST_EFFICIENT_USD=0.97
COST_CAP_PROFESSIONAL_USD=3.70
# Text placement ignores key-object boxes bigger than this share of the image (regions)
OBJECT_MAX_AREA=0.30
# Stripe TEST mode only: sk_test_... (anything else disables billing).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# whsec_... from `stripe listen --forward-to localhost:7659/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Comma-separated admin emails (refund approvals, cost stats at /admin)
ADMIN_EMAILS=you@example.com,partner@example.com
# Quality tiers (the buyer picks one per book / Quick Scenes run; default Cost-Efficient).
# Professional: hero, family sheet and pages use PROFESSIONAL_IMAGE_MODEL; empty = the old
# behaviour (GEMINI_IMAGE_MODEL for hero + family sheet, PAGE_IMAGE_MODEL for pages).
PROFESSIONAL_IMAGE_MODEL=
PRICE_PROFESSIONAL_CENTS=399
# Cost-Efficient: ONE model for hero, family sheet and pages. Empty = gemini-3.1-flash-lite-image;
# to A/B test, set gemini-nano-banana-2.1 here (both are in app/providers/pricing.py).
COST_EFFICIENT_IMAGE_MODEL=
PRICE_COST_EFFICIENT_CENTS=99
# Legacy single price. Leave EMPTY for the per-tier prices above. When set to any number it
# OVERRIDES BOTH tier prices - e.g. BOOK_PRICE_CENTS=0 makes every book free for local testing.
BOOK_PRICE_CENTS=
LOG_LEVEL=INFO

# Used by docker-compose for the db service
POSTGRES_PASSWORD=
